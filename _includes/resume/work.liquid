{% assign processed_work = "" | split: "" %}

{% for item in data[1] %}
  {% assign raw_end = item.endDate | default: "9999-12-31" %}
  {% if raw_end == "" %}
    {% assign fixed_end = "9999-12-31" %}
  {% else %}
    {% assign fixed_end = raw_end %}
  {% endif %}
  {% capture sort_key %}{{ fixed_end | date: "%Y%m%d" }}{% endcapture %}
  {% assign item = item | merge: {"_sort_key": sort_key} %}
  {% assign processed_work = processed_work | push: item %}
{% endfor %}

{% assign sorted_work = processed_work | sort: "_sort_key" | reverse %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in sorted_work %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% assign startDateFormatted = content.startDate | date: "%B %Y" %}
          {% if content.endDate == "" or content.endDate == nil %}
            {% assign endDateFormatted = "Present" %}
          {% else %}
            {% assign endDateFormatted = content.endDate | date: "%B %Y" %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> 
                    {{ startDateFormatted }} - {{ endDateFormatted }} 
                  </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {{ content.position }}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.name }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <ul class="items">
            {% for item in content.highlights %}
              <li><span class="item">{{ item }}</span></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
