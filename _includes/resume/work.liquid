<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work_sorted = data[1] | map: "content" %}

  {%- comment -%}
  Assign sort keys: "9999-12-31" for missing endDate, then sort descending
  {%- endcomment -%}
  {% for content in work_sorted %}
    {% assign rawEndDate = content.endDate | default: "9999-12-31" %}
    {% capture sortKey %}{{ rawEndDate | date: "%Y%m%d" }}{% endcapture %}
    {% assign content = content | merge: {"sortKey": sortKey} %}
  {% endfor %}

  {%- assign sorted_work = work_sorted | sort: "sortKey" | reverse -%}

  {% for content in sorted_work %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
          {% assign endDateRaw = content.endDate | default: "" %}
          {% if endDateRaw == "" %}
            {% assign endDate = "Present" %}
          {% else %}
            {% assign endDate = endDateRaw | split: '-' | slice: 0, 2 | join: '.' %}
          {% endif %}
          {% assign date = startDate | append: ' - ' | append: endDate %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.position }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.name }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
