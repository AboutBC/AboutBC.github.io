
@article{pyrooz2026gva,
  author = {David C. Pyrooz and Brendan Cirillo and Jillian J. Turanovic},
  title = {The Limits of the Gun Violence Archive as a Public Health Data Source: Evidence on Fatal and Nonfatal Shootings in Aurora, Colorado, 2017--2026},
  journal = {American Journal of Public Health},
  year = {2026},
  doi = {10.2105/AJPH.2026.308854},
  note = {Published online November 19, 2026},
  abstract = {This paper examines the reliability of the Gun Violence Archive (GVA) as a source of public health data using administrative police records from Aurora, Colorado. Although 94 percent of GVA incidents matched police records, only 60 percent of police-recorded shootings appeared in GVA. Coverage varied systematically across victim characteristics, incident severity, arrests, and geography, highlighting limitations in using publicly available data to estimate firearm violence.},
  html = {https://ajph.aphapublications.org/doi/10.2105/AJPH.2026.308854},
  selected = {true}
}

@unpublished{cirillo2026shelby,
  author = {Brendan Cirillo and Jeffrey Milyo},
  title = {Does Federal Preclearance of State Election Laws Make a Difference? Examining the Effects of Shelby on the Minority Voting Gap and Countermobilization},
  year = {2026},
  note = {Working paper},
  doi = {10.2139/ssrn.7232478},
  abstract = {We examine the effects of Shelby County v. Holder (2013) on minority voter turnout and registration using a triple-difference design. We find no evidence that ending federal preclearance widened minority voting gaps. We also examine the targeting of preclearance under the proposed John Lewis Voting Rights Advancement Act and test whether minority countermobilization explains the observed results.},
  html = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7232478},
  selected = {true}
}

@unpublished{cirillo2026ptp,
  author = {Brendan Cirillo},
  title = {State Differences in Handgun Permit-to-Purchase Responses: Criminal Usage and Purchasing},
  year = {2026},
  note = {Working paper},
  abstract = {Permit-to-purchase (PTP) is a state requirement to obtain a license prior to purchasing a gun. This paper uses synthetic control methods to estimate the effects of PTP laws in three states on gun purchasing behavior and usage for crime, as well as downstream effects on homicides and suicides. In Missouri, repealing PTP led to a 12.9% rise in background checks, a 22 percentage point increase in the self-sourced share of crime guns, and a 2.4-year drop in time-to-crime, alongside a 37.9% increase in firearm homicides and a delayed increase in suicide. Consistent with Missouri, Maryland's adoption of PTP reduced background checks by 23.4%, lowered the self-sourced ratio by 9.4 points, and increased time-to-crime by 3.3 years, though no short-run mortality effects were detected. Across Connecticut, Maryland, and Missouri, metropolitan areas respond immediately to PTP changes, while effects in rural areas emerge more gradually, if at all.},
  pdf = {ptp_paper_sept25.pdf},
  whitepaper = {white_paper_style_md.pdf},
  appendix = {cirillo_jmp_online_appendix.pdf},
  selected = {true}
}
